# Змінні для docker compose (sandbox). Скопіюйте в infra/.env
APP_ENV=sandbox
DEBUG=true
POSTGRES_USER=shelter
POSTGRES_PASSWORD=shelter_sandbox_pw
POSTGRES_DB=shelter_sandbox
SECRET_KEY=sandbox-secret-password
ACCESS_TOKEN_EXPIRE_MINUTES=60
CACHE_ENABLED=false
BACKEND_PORT=8000
HTTP_PORT=8080
DB_HOST_PORT=55432
LB_ALGO=round_robin
