# Змінні для docker compose (production). Скопіюйте в infra/.env.production
# Запуск: docker compose --env-file .env.production -p shelter-production up --build -d
APP_ENV=production
DEBUG=false
POSTGRES_USER=shelter_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
