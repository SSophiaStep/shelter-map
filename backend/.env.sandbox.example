# Тестове середовище (sandbox). Скопіюйте в .env.sandbox і задайте свої значення.
APP_ENV=sandbox
DEBUG=true
SQL_ECHO=false
DATABASE_URL=postgresql+asyncpg://shelter:shelter@127.0.0.1:55432/shelter_sandbox
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=sandbox-secret-replace-with-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CACHE_ENABLED=false
