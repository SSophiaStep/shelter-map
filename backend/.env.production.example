# Робоче середовище (production). Скопіюйте в .env.production.
# Файл .env.production НЕ комітиться; SECRET_KEY і пароль БД мають бути унікальними.
APP_ENV=production
DEBUG=false
SQL_ECHO=false
DATABASE_URL=postgresql+asyncpg://shelter_prod:CHANGE_ME@127.0.0.1:55432/shelter_production
REDIS_URL=redis://127.0.0.1:6379/1
SECRET_KEY=change-me-generate-with-python-secrets-token_hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
CACHE_ENABLED=true
